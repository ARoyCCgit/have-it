# ==========================================
# Have-it Super-App — Master .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env*.local

# Allow example files
!**/.env.example

# Next.js Build Outputs
.next/
**/.next/
out/
**/out/

# TypeScript & Compiler Outputs
dist/
**/dist/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# Production & Packaging
build/
**/build/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Keystores, Certificates & Mobile Secrets
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Native Mobile Platforms (if generated by Capacitor)
android/.gradle/
android/app/build/
android/local.properties
ios/Pods/
ios/App/build/
ios/App/DerivedData/

# OS & Editor Files
.DS_Store
*.pem
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
