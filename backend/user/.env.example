# Have-it — User & Authentication Microservice (.env.example)
PORT=5000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/haveit_user?retryWrites=true&w=majority

# Upstash or Local Redis URL (for OTP caching & rate limiting)
REDIS_URL=redis://localhost:6379

# RabbitMQ Message Broker (CloudAMQP AMQPS URL or local credentials)
RABBITMQ_URL=amqps://<username>:<password>@puffin.rmq2.cloudamqp.com/<vhost>
Rabbit_Host=localhost
Rabbit_User=guest
Rabbit_Pass=guest

# JWT Secret for Session Authentication
JWT_TOKEN=your_secure_random_jwt_secret_key_here

# Cloudinary Storage Credentials (for User Avatar uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
