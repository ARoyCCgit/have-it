# Have-it — Chat & Real-Time Socket.IO Microservice (.env.example)
PORT=5002

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/haveit_chat?retryWrites=true&w=majority

# JWT Secret (must match User service)
JWT_TOKEN=your_secure_random_jwt_secret_key_here

# Internal User Service Endpoint
USER_SERVICE=http://localhost:5000

# Cloudinary Storage Credentials (for Photos, Videos & Voice Notes)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
