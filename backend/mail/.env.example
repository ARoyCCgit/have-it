# Have-it — Mail Microservice (.env.example)
PORT=5001

# RabbitMQ Message Broker (CloudAMQP AMQPS URL or local credentials)
RABBITMQ_URL=amqps://<username>:<password>@puffin.rmq2.cloudamqp.com/<vhost>
Rabbit_Host=localhost
Rabbit_User=guest
Rabbit_Pass=guest

# SMTP Email Dispatch Credentials (Nodemailer for local development)
Nodemailer_User=arnabroy466@gmail.com
Nodemailer_Pass=your-gmail-app-password

# Cloud-friendly Email API (HTTPS Port 443 — NEVER blocked by Render or cloud firewalls)
# Brevo (formerly Sendinblue) — Free 300 emails/day to ANY email address WITHOUT domain verification!
# Get free key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=arnabroy466@gmail.com
