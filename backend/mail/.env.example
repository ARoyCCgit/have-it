# Have-it — Mail Microservice (.env.example)
PORT=5001

# RabbitMQ Message Broker (CloudAMQP AMQPS URL or local credentials)
RABBITMQ_URL=amqps://<username>:<password>@puffin.rmq2.cloudamqp.com/<vhost>
Rabbit_Host=localhost
Rabbit_User=guest
Rabbit_Pass=guest

# SMTP Email Dispatch Credentials (Nodemailer)
Nodemailer_User=your-email@example.com
Nodemailer_Pass=your-smtp-app-password
