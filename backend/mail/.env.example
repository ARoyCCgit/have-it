# Have-it — Mail Microservice (.env.example)
PORT=5001

# RabbitMQ Message Broker (CloudAMQP AMQPS URL or local credentials)
RABBITMQ_URL=amqps://<username>:<password>@puffin.rmq2.cloudamqp.com/<vhost>
Rabbit_Host=localhost
Rabbit_User=guest
Rabbit_Pass=guest

# SMTP Email Dispatch Credentials (Nodemailer for local development)
Nodemailer_User=your-email@example.com
Nodemailer_Pass=your-smtp-app-password

# Cloud-friendly Email API (HTTPS Port 443 — NEVER blocked by Render or cloud firewalls)
# Option 1: Brevo (Sendinblue) — Free 300 emails/day to ANY email address WITHOUT domain verification!
# Get key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=arnabroy466@gmail.com

# Option 2: Resend — Free 100 emails/day (Only sends to account email unless domain verified)
# Get free key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Have-it <onboarding@resend.dev>"
