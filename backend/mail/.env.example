# Have-it — Mail Microservice (.env.example)
PORT=5001

# RabbitMQ Message Broker (CloudAMQP AMQPS URL or local credentials)
RABBITMQ_URL=amqps://<username>:<password>@puffin.rmq2.cloudamqp.com/<vhost>
Rabbit_Host=localhost
Rabbit_User=guest
Rabbit_Pass=guest

# SMTP Email Dispatch Credentials (Nodemailer for local development)
Nodemailer_User=your-email@example.com
Nodemailer_Pass=your-smtp-app-password

# Cloud-friendly Email API (Resend HTTPS API — Recommended for Render / Cloud)
# Get free key at https://resend.com (Bypasses Render SMTP port blocking)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Have-it <onboarding@resend.dev>"
