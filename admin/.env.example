# Have-it — Admin Command Center (.env.example)
PORT=3001
NEXT_PUBLIC_PORT=3001

# Microservices API Endpoints
NEXT_PUBLIC_USER_SERVICE=http://localhost:5000
NEXT_PUBLIC_CHAT_SERVICE=http://localhost:5002
NEXT_PUBLIC_POST_SERVICE=http://localhost:5003

# Application Branding
NEXT_PUBLIC_APP_NAME="Have-it Admin"

# Direct Read-Only or Admin MongoDB Connection for Aggregations
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/haveit?retryWrites=true&w=majority
